{
  "manifest_version": 3,
  "name": "SelectionTranslator for Safari",
  "version": "0.4.1",
  "description": "把 Safari 选区连同上下文发送给本机 SelectionTranslator。",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
