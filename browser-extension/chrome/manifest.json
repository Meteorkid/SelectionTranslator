{
  "manifest_version": 3,
  "name": "SelectionTranslator Browser Bridge",
  "version": "0.4.3",
  "description": "把浏览器选区连同上下文发送给本机 SelectionTranslator。",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "翻译当前浏览器选区"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
